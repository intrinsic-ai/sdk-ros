cmake_minimum_required(VERSION 3.16)
project(@SKILL_NAME@)

find_package(ament_cmake REQUIRED)
find_package(intrinsic_sdk_cmake REQUIRED)
find_package(zenoh_cpp_vendor REQUIRED)
find_package(absl REQUIRED)

intrinsic_sdk_protobuf_generate(
  NAME @SKILL_NAME@
  SOURCES @SKILL_NAME@.proto
  TARGET @SKILL_NAME@_protos
  DESCRIPTOR_SET_OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/@SKILL_NAME@.desc"
)

intrinsic_sdk_generate_skill_config(
  TARGET @SKILL_NAME@_skill_config
  SKILL_NAME @SKILL_NAME@
  MANIFEST @SKILL_NAME@.manifest.textproto
  PROTO_DESCRIPTOR_FILE "${CMAKE_CURRENT_BINARY_DIR}/@SKILL_NAME@.desc"
  SKILL_CONFIG_FILE_OUTPUT
    "${CMAKE_CURRENT_BINARY_DIR}/@SKILL_NAME@_config.pbbin"
)

intrinsic_sdk_generate_skill_main_cc(
  MANIFEST @SKILL_NAME@.manifest.textproto
  HEADER_FILES @SKILL_NAME@.h
  MAIN_FILE_OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/@SKILL_NAME@_main.cc"
)

add_executable(@SKILL_NAME@_main
  "${CMAKE_CURRENT_BINARY_DIR}/@SKILL_NAME@_main.cc"
  @SKILL_NAME@.cc
)
target_include_directories(@SKILL_NAME@_main
  PRIVATE
    "${CMAKE_CURRENT_SOURCE_DIR}"
)
target_link_libraries(@SKILL_NAME@_main
  intrinsic_sdk_cmake::intrinsic_sdk_cmake
  @SKILL_NAME@_protos
  zenohcxx::zenohc
  absl::status
  absl::log
)
install(TARGETS @SKILL_NAME@_main DESTINATION lib/${PROJECT_NAME})
add_dependencies(@SKILL_NAME@_main @SKILL_NAME@_skill_config)

add_executable(@SKILL_NAME@_client
  @SKILL_NAME@_client.cc
)
target_include_directories(@SKILL_NAME@_client
  PRIVATE
    "${CMAKE_CURRENT_SOURCE_DIR}"
)
target_link_libraries(@SKILL_NAME@_client
  gRPC::grpc++
  @SKILL_NAME@_protos
  intrinsic_sdk_cmake::intrinsic_sdk_cmake
)
install(TARGETS @SKILL_NAME@_client DESTINATION lib/${PROJECT_NAME})

install(
  FILES
    "${CMAKE_CURRENT_BINARY_DIR}/@SKILL_NAME@_config.pbbin"
    @SKILL_NAME@.manifest.textproto
    package.xml
  DESTINATION share/${PROJECT_NAME}
)

install(
  FILES "${CMAKE_CURRENT_BINARY_DIR}/@SKILL_NAME@.desc"
  DESTINATION share/${PROJECT_NAME}
  RENAME @SKILL_NAME@_protos.desc
)

ament_package()
