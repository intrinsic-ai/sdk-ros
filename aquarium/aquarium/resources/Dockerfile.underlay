FROM localhost/aquarium-sdk-underlay-deps:latest AS base

WORKDIR /workspace
ARG SDK_ROS_DIR=src/sdk-ros
COPY ${SDK_ROS_DIR} ${SDK_ROS_DIR}

# Install SDK dependencies
RUN apt-get update && rosdep update && \
    . /opt/ros/lyrical/setup.bash && \
    rosdep install -y --rosdistro lyrical --ignore-src \
    --from-paths $(colcon list --packages-up-to intrinsic_sdk_cmake \
        --paths-only) \
    && rm -rf /var/lib/apt/lists/*

# Build SDK and clean up immediately to save space
RUN . /opt/ros/lyrical/setup.bash && \
    NPROC=$(nproc) && \
    export MAKEFLAGS="-j${NPROC}" && \
    export CMAKE_BUILD_PARALLEL_LEVEL=${NPROC} && \
    colcon build \
    --cmake-args -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_POLICY_VERSION_MINIMUM=3.5 -DBUILD_TESTING=OFF \
    --packages-up-to intrinsic_sdk_cmake && \
    rm -rf build log /root/.cache
