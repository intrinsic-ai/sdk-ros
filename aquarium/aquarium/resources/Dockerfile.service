FROM aquarium-sdk-underlay:latest AS build
WORKDIR /workspace

ARG OUTPUT_DIR=build/aquarium_images
ARG TARGET_PACKAGE=""
ARG ROSDEP_SKIP_KEYS=""
ARG TARGET_APT_PACKAGE=""

# Copy workspace sources and ignore packages already built in the SDK underlay
COPY src/ /workspace/src/
RUN find /workspace/src -maxdepth 3 -type d -name "ros_gz_bridge_vendor" \
        -exec touch "{}/COLCON_IGNORE" \; && \
    for pkg_xml in $(find /workspace/src -name package.xml); do \
      pkg_dir=$(dirname "$pkg_xml"); \
      pkg_name=$(sed -n \
        's|.*<name>[[:space:]]*\([^<[:space:]]*\)[[:space:]]*</name>.*|\1|p' \
        "$pkg_xml" | head -n 1); \
      if [ -n "$pkg_name" ] && [ "$pkg_name" != "aquarium" ] && \
         [ -d "/workspace/install/$pkg_name" ]; then \
        touch "$pkg_dir/COLCON_IGNORE"; \
      fi; \
    done

# Install dependencies for workspace sources and build the target closure
RUN apt-get update && rosdep update && \
    apt-get install -y --no-install-recommends python3-pip && \
    . /opt/ros/lyrical/setup.bash && \
    . /workspace/install/setup.bash && \
    if [ -n "${TARGET_APT_PACKAGE}" ]; then \
        apt-get install -y --no-install-recommends ${TARGET_APT_PACKAGE}; \
    fi && \
    WS_TARGET_PKGS="aquarium" && \
    for pkg in ${TARGET_PACKAGE}; do \
        if [ "$pkg" != "aquarium" ] && \
           [ -n "$(colcon list --packages-select "$pkg" \
                   --names-only 2>/dev/null)" ]; then \
            WS_TARGET_PKGS="$WS_TARGET_PKGS $pkg"; \
        fi; \
    done && \
    TARGET_PATHS=$(colcon list --packages-up-to $WS_TARGET_PKGS \
        --paths-only) && \
    TARGET_NAMES=$(colcon list --packages-up-to $WS_TARGET_PKGS \
        --names-only) && \
    echo "$TARGET_NAMES" > /workspace/target_packages.txt && \
    echo "$TARGET_PATHS" > /workspace/target_paths.txt && \
    SKIP_ARGS="" && \
    if [ -n "${ROSDEP_SKIP_KEYS}" ]; then \
        for k in ${ROSDEP_SKIP_KEYS}; do \
            SKIP_ARGS="$SKIP_ARGS --skip-keys=$k"; \
        done; \
    fi && \
    (rosdep install \
    --dependency-types=build \
    --dependency-types=buildtool \
    --dependency-types=build_export \
    --dependency-types=buildtool_export \
    --dependency-types=exec \
    -r -y --rosdistro lyrical --ignore-src \
    $SKIP_ARGS \
    --from-paths $TARGET_PATHS || true) && \
    colcon build \
    --cmake-args -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_POLICY_VERSION_MINIMUM=3.5 -DBUILD_TESTING=OFF \
    --packages-select $TARGET_NAMES && \
    rm -rf /var/lib/apt/lists/*

# Copy proto definitions and compile descriptor set and python bindings
COPY ${OUTPUT_DIR}/*_config.proto /workspace/
COPY ${OUTPUT_DIR}/runtime_context.proto /workspace/
RUN mkdir -p /workspace/config_protos && \
    protoc --proto_path=/workspace --include_imports \
        --descriptor_set_out=/workspace/config.desc \
        /workspace/*_config.proto && \
    protoc --proto_path=/workspace \
        --python_out=/workspace/config_protos \
        /workspace/*_config.proto && \
    protoc --proto_path=/workspace \
        --python_out=/workspace/config_protos \
        /workspace/runtime_context.proto

# Prune non-runtime files using regex patterns targeting largest files first
COPY ${OUTPUT_DIR}/prune_runtime_artifacts.py /workspace/
RUN python3 /workspace/prune_runtime_artifacts.py /workspace/install

# Record runtime APT packages for shared libs outside /workspace/install
RUN . /opt/ros/lyrical/setup.bash && \
    . /workspace/install/setup.bash && \
    find /workspace/install /opt/ros/lyrical \
        \( -type f -o -type l \) -name "*.so*" \
        | sed 's|/[^/]*$||' | sort -u \
        > /etc/ld.so.conf.d/service_build.conf && \
    ldconfig && \
    find /workspace/install -type f \( -executable -o -name "*.so*" \) \
        -exec ldd {} + 2>/dev/null \
        | awk '/=> \// {print $3}' \
        | grep -v '^/workspace/install/' \
        | sort -u > /tmp/needed_libs.txt && \
    > /tmp/runtime_pkgs.txt && \
    while read -r lib; do \
        real_lib=$(readlink -f "$lib" 2>/dev/null || echo "$lib"); \
        for candidate in "$real_lib" "${real_lib#/usr}" "/usr${real_lib}" \
                         "$lib"; do \
            pkg=$(dpkg-query -S "$candidate" 2>/dev/null \
                | grep -v '^diversion ' | head -n 1 | cut -d: -f1); \
            if [ -n "$pkg" ]; then \
                echo "$pkg" >> /tmp/runtime_pkgs.txt; \
                break; \
            fi; \
        done; \
    done < /tmp/needed_libs.txt && \
    sort -u /tmp/runtime_pkgs.txt > /workspace/runtime_apt_packages.txt && \
    rm -f /tmp/needed_libs.txt /tmp/runtime_pkgs.txt

# Stage 2: Result (Final minimal runtime image)
FROM docker.io/library/ros:lyrical-ros-core AS result
SHELL ["/bin/bash", "-c"]
ENV RMW_IMPLEMENTATION=rmw_zenoh_cpp
ENV ROS_HOME=/tmp
WORKDIR /workspace

ARG OUTPUT_DIR=build/aquarium_images
ARG ROSDEP_SKIP_KEYS=""
ARG PRUNE_PATTERNS=""
ARG TARGET_APT_PACKAGE=""

# Copy pruned install tree and discovered runtime APT packages from build stage
COPY --from=build /workspace/install /workspace/install
COPY --from=build /workspace/target_packages.txt /workspace/target_packages.txt
COPY --from=build /workspace/runtime_apt_packages.txt \
    /tmp/runtime_apt_packages.txt

# Install runtime dependencies for the built workspace packages
RUN apt-get update && \
    if [ -s /tmp/runtime_apt_packages.txt ]; then \
        apt-get install -y --no-install-recommends \
            $(cat /tmp/runtime_apt_packages.txt); \
    fi && \
    (ln -sf /usr/lib/x86_64-linux-gnu/libxml2.so.16 \
        /usr/lib/x86_64-linux-gnu/libxml2.so.2 || true) && \
    apt-get install -y --no-install-recommends python3-rosdep && \
    (rosdep init || true) && \
    rosdep update && \
    rm -f /workspace/install/COLCON_IGNORE && \
    TARGET_INSTALL_PATHS="" && \
    if [ -f /workspace/target_packages.txt ]; then \
        while read -r pkg; do \
            if [ -n "$pkg" ] && [ -d "/workspace/install/$pkg" ]; then \
                TARGET_INSTALL_PATHS=\
"$TARGET_INSTALL_PATHS /workspace/install/$pkg"; \
            fi; \
        done < /workspace/target_packages.txt; \
    fi && \
    if [ -z "$TARGET_INSTALL_PATHS" ]; then \
        TARGET_INSTALL_PATHS="/workspace/install"; \
    fi && \
    SKIP_ARGS="" && \
    if [ -n "${ROSDEP_SKIP_KEYS}" ]; then \
        for k in ${ROSDEP_SKIP_KEYS}; do \
            SKIP_ARGS="$SKIP_ARGS --skip-keys=$k"; \
        done; \
    fi && \
    (rosdep install --dependency-types=exec -r -y \
        --rosdistro lyrical --ignore-src \
        $SKIP_ARGS \
        --from-paths $TARGET_INSTALL_PATHS || true) && \
    if [ -n "${TARGET_APT_PACKAGE}" ]; then \
        apt-get install -y --no-install-recommends ${TARGET_APT_PACKAGE}; \
    fi && \
    (apt-get remove -y --purge python3-protobuf \
        python3-rosdep 2>/dev/null || true) && \
    apt-get install -y --no-install-recommends \
        ros-lyrical-rmw-zenoh-cpp \
        python3-pip \
        socat && \
    pip3 install --break-system-packages "protobuf>=4.21.0,<6.0.0" && \
    apt-get purge -y python3-pip && \
    if [ -n "${PRUNE_PATTERNS}" ]; then \
        for p in ${PRUNE_PATTERNS}; do \
            rm -rf $p 2>/dev/null || true; \
        done; \
    fi && \
    rm -rf /var/lib/apt/lists/* /root/.ros /root/.cache \
           /tmp/runtime_apt_packages.txt \
           /usr/bin/ctest /usr/bin/cpack /usr/bin/cmake && \
    find /workspace/install /opt/ros/lyrical \
        \( -type f -o -type l \) -name "*.so*" \
        | sed 's|/[^/]*$||' | sort -u \
        > /etc/ld.so.conf.d/aquarium_install.conf && \
    ldconfig && \
    GW_BIN=/workspace/install/aquarium/lib/aquarium/aquarium_gateway && \
    if ldd "$GW_BIN" | grep -q "not found"; then \
        echo "ERROR: Missing shared libs for $GW_BIN:" >&2; \
        ldd "$GW_BIN" | grep "not found" >&2; \
        exit 1; \
    fi

# Copy config and launch files
ARG CONFIG_PATH
ARG LAUNCH_PATH
COPY ${CONFIG_PATH} /workspace/aquarium.yaml
COPY ${LAUNCH_PATH} /workspace/aquarium_launch.xml

# Copy hermetically generated descriptor and python bindings
COPY --from=build /workspace/config.desc /workspace/config.desc
COPY --from=build /workspace/config_protos/ /workspace/config_protos/

# Copy entrypoint scripts
ARG ENTRYPOINT_PATH=${OUTPUT_DIR}/entrypoint.py
COPY ${ENTRYPOINT_PATH} /workspace/entrypoint.py
COPY ${OUTPUT_DIR}/entrypoint.sh /workspace/entrypoint.sh
RUN chmod -R a+rX /workspace && \
    chmod 755 /workspace/entrypoint.py /workspace/entrypoint.sh

ENTRYPOINT ["/workspace/entrypoint.sh"]
