<?xml version="1.0"?>
<?xml-model
  href="http://download.ros.org/schema/package_format2.xsd"
  schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="2">
  <name>highwayhash_vendor</name>
  <version>0.1.0</version>
  <description>
    Wrapper around highwayhash, providing it for riegeli_vendor.
  </description>

  <maintainer email="wjwwood@intrinsic.ai">William Woodall</maintainer>

  <license>Apache-2.0</license>

  <author email="wjwwood@intrinsic.ai">William Woodall</author>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_vendor_package</buildtool_depend>

  <!--
    TODO(wjwwood): highwayhash is required by riegeli (riegeli_vendor). Upstream
    highwayhash does not ship a CMake build and there is no upstream rosdep key
    for libhighwayhash-dev. Once a rosdep key exists (with CMake/pkg-config support)
    or SDK C++ targets are extracted from Bazel, this vendor package can be retired.
  -->

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
