diff --git a/CMakeLists.txt b/CMakeLists.txt
new file mode 100644
index 0000000..8b187b5
--- /dev/null
+++ b/CMakeLists.txt
@@ -0,0 +1,161 @@
+cmake_minimum_required(VERSION 3.15)
+project(riegeli LANGUAGES CXX)
+
+include(CMakePackageConfigHelpers)
+include(GNUInstallDirs)
+
+if(NOT DEFINED CMAKE_CXX_STANDARD)
+  set(CMAKE_CXX_STANDARD 20)
+endif()
+set(CMAKE_CXX_STANDARD_REQUIRED ON)
+set(CMAKE_POSITION_INDEPENDENT_CODE ON)
+
+find_package(absl REQUIRED)
+find_package(Protobuf CONFIG REQUIRED)
+find_package(Snappy 1.2.0 CONFIG REQUIRED)
+find_package(highwayhash CONFIG REQUIRED)
+find_package(BZip2 REQUIRED)
+find_package(ZLIB REQUIRED)
+find_package(zstd CONFIG REQUIRED)
+find_package(PkgConfig REQUIRED)
+pkg_check_modules(BROTLI REQUIRED IMPORTED_TARGET libbrotlicommon libbrotlidec libbrotlienc)
+
+# Compile riegeli's records_metadata.proto
+set(RIEGELI_PROTO_DIR "${CMAKE_CURRENT_BINARY_DIR}/riegeli_proto_gen")
+file(MAKE_DIRECTORY "${RIEGELI_PROTO_DIR}")
+set(RIEGELI_PROTO_SRC "${CMAKE_CURRENT_SOURCE_DIR}/riegeli/records/records_metadata.proto")
+set(RIEGELI_PROTO_PB_CC "${RIEGELI_PROTO_DIR}/riegeli/records/records_metadata.pb.cc")
+set(RIEGELI_PROTO_PB_H "${RIEGELI_PROTO_DIR}/riegeli/records/records_metadata.pb.h")
+
+add_custom_command(
+  OUTPUT "${RIEGELI_PROTO_PB_CC}" "${RIEGELI_PROTO_PB_H}"
+  COMMAND protobuf::protoc
+    --cpp_out=${RIEGELI_PROTO_DIR}
+    -I ${CMAKE_CURRENT_SOURCE_DIR}
+    ${RIEGELI_PROTO_SRC}
+  DEPENDS "${RIEGELI_PROTO_SRC}" protobuf::protoc
+  COMMENT "Generating C++ protocol buffer for riegeli/records/records_metadata.proto"
+  VERBATIM
+)
+
+file(GLOB_RECURSE riegeli_SRCS
+  "${CMAKE_CURRENT_SOURCE_DIR}/riegeli/base/*.cc"
+  "${CMAKE_CURRENT_SOURCE_DIR}/riegeli/brotli/*.cc"
+  "${CMAKE_CURRENT_SOURCE_DIR}/riegeli/bytes/*.cc"
+  "${CMAKE_CURRENT_SOURCE_DIR}/riegeli/bzip2/*.cc"
+  "${CMAKE_CURRENT_SOURCE_DIR}/riegeli/chunk_encoding/*.cc"
+  "${CMAKE_CURRENT_SOURCE_DIR}/riegeli/containers/*.cc"
+  "${CMAKE_CURRENT_SOURCE_DIR}/riegeli/digests/*.cc"
+  "${CMAKE_CURRENT_SOURCE_DIR}/riegeli/messages/*.cc"
+  "${CMAKE_CURRENT_SOURCE_DIR}/riegeli/ordered_varint/*.cc"
+  "${CMAKE_CURRENT_SOURCE_DIR}/riegeli/records/*.cc"
+  "${CMAKE_CURRENT_SOURCE_DIR}/riegeli/snappy/*.cc"
+  "${CMAKE_CURRENT_SOURCE_DIR}/riegeli/varint/*.cc"
+  "${CMAKE_CURRENT_SOURCE_DIR}/riegeli/zlib/*.cc"
+  "${CMAKE_CURRENT_SOURCE_DIR}/riegeli/zstd/*.cc"
+)
+list(FILTER riegeli_SRCS EXCLUDE REGEX "_test\\.cc$")
+list(FILTER riegeli_SRCS EXCLUDE REGEX "_benchmark\\.cc$")
+list(FILTER riegeli_SRCS EXCLUDE REGEX "/tools/")
+list(APPEND riegeli_SRCS "${RIEGELI_PROTO_PB_CC}")
+
+add_library(riegeli ${riegeli_SRCS})
+add_library(riegeli::riegeli ALIAS riegeli)
+
+# Ensure Snappy >= 1.2.0 headers take precedence over any older system snappy.h
+# that might be in /usr/include on Ubuntu 24.04.
+get_target_property(_snappy_include_dirs Snappy::snappy INTERFACE_INCLUDE_DIRECTORIES)
+if(_snappy_include_dirs)
+  target_include_directories(riegeli BEFORE PUBLIC ${_snappy_include_dirs})
+endif()
+
+target_include_directories(riegeli PUBLIC
+  "$<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}>"
+  "$<BUILD_INTERFACE:${RIEGELI_PROTO_DIR}>"
+  "$<INSTALL_INTERFACE:${CMAKE_INSTALL_INCLUDEDIR}>"
+)
+
+target_link_libraries(riegeli PUBLIC
+  absl::any_invocable
+  absl::base
+  absl::cleanup
+  absl::cord
+  absl::core_headers
+  absl::crc32c
+  absl::errno_saver
+  absl::flat_hash_map
+  absl::flat_hash_set
+  absl::function_ref
+  absl::hash
+  absl::inlined_vector
+  absl::int128
+  absl::layout
+  absl::log
+  absl::log_internal_check_op
+  absl::memory
+  absl::meta
+  absl::node_hash_map
+  absl::node_hash_set
+  absl::nullability
+  absl::numeric
+  absl::optional
+  absl::prefetch
+  absl::span
+  absl::status
+  absl::statusor
+  absl::str_format
+  absl::strings
+  absl::synchronization
+  absl::time
+  absl::type_traits
+  absl::utility
+  absl::variant
+  BZip2::BZip2
+  highwayhash::highwayhash
+  PkgConfig::BROTLI
+  protobuf::libprotobuf
+  Snappy::snappy
+  ZLIB::ZLIB
+  zstd::libzstd_shared
+)
+target_link_options(riegeli PRIVATE "-Wl,--no-undefined")
+
+configure_package_config_file(
+  "${CMAKE_CURRENT_SOURCE_DIR}/cmake/riegeliConfig.cmake.in"
+  "${CMAKE_CURRENT_BINARY_DIR}/riegeliConfig.cmake"
+  INSTALL_DESTINATION "${CMAKE_INSTALL_LIBDIR}/cmake/riegeli"
+)
+
+install(
+  TARGETS riegeli
+  EXPORT riegeliTargets
+  ARCHIVE DESTINATION "${CMAKE_INSTALL_LIBDIR}"
+  LIBRARY DESTINATION "${CMAKE_INSTALL_LIBDIR}"
+  RUNTIME DESTINATION "${CMAKE_INSTALL_BINDIR}"
+)
+
+install(
+  EXPORT riegeliTargets
+  FILE riegeliTargets.cmake
+  NAMESPACE riegeli::
+  DESTINATION "${CMAKE_INSTALL_LIBDIR}/cmake/riegeli"
+)
+
+install(
+  DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}/riegeli/"
+  DESTINATION "${CMAKE_INSTALL_INCLUDEDIR}/riegeli"
+  FILES_MATCHING
+  PATTERN "*.h"
+  PATTERN "*.inc"
+)
+install(
+  DIRECTORY "${RIEGELI_PROTO_DIR}/riegeli/"
+  DESTINATION "${CMAKE_INSTALL_INCLUDEDIR}/riegeli"
+  FILES_MATCHING
+  PATTERN "*.h"
+)
+
+install(
+  FILES "${CMAKE_CURRENT_BINARY_DIR}/riegeliConfig.cmake"
+  DESTINATION "${CMAKE_INSTALL_LIBDIR}/cmake/riegeli"
+)
diff --git a/cmake/riegeliConfig.cmake.in b/cmake/riegeliConfig.cmake.in
new file mode 100644
index 0000000..6590087
--- /dev/null
+++ b/cmake/riegeliConfig.cmake.in
@@ -0,0 +1,16 @@
+@PACKAGE_INIT@
+
+include(CMakeFindDependencyMacro)
+find_dependency(absl REQUIRED)
+find_dependency(Protobuf CONFIG REQUIRED)
+find_dependency(Snappy 1.2.0 CONFIG REQUIRED)
+find_dependency(highwayhash CONFIG REQUIRED)
+find_dependency(BZip2 REQUIRED)
+find_dependency(ZLIB REQUIRED)
+find_dependency(zstd CONFIG REQUIRED)
+find_dependency(PkgConfig REQUIRED)
+pkg_check_modules(BROTLI REQUIRED IMPORTED_TARGET libbrotlicommon libbrotlidec libbrotlienc)
+
+include("${CMAKE_CURRENT_LIST_DIR}/riegeliTargets.cmake")
+
+check_required_components(riegeli)
