<?xml version="1.0"?>
<?xml-model
  href="http://download.ros.org/schema/package_format2.xsd"
  schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="2">
  <name>brotli_vendor</name>
  <version>0.1.0</version>
  <description>
    Wrapper around brotli, providing it if not found on the system.
  </description>

  <maintainer email="wjwwood@intrinsic.ai">William Woodall</maintainer>

  <license>Apache-2.0</license>

  <author email="wjwwood@intrinsic.ai">William Woodall</author>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_vendor_package</buildtool_depend>
  <buildtool_depend>pkg-config</buildtool_depend>

  <!--
    TODO(wjwwood): Once a rosdep key for libbrotli-dev is available upstream,
    add it here as a <depend> and consider retiring brotli_vendor once all
    supported Ubuntu/ROS distributions provide it via rosdep.
  -->

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
