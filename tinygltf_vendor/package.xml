<?xml version="1.0"?>
<?xml-model
  href="http://download.ros.org/schema/package_format2.xsd"
  schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="2">
  <name>tinygltf_vendor</name>
  <version>0.1.0</version>
  <description>
    Wrapper around tinygltf, providing it for intrinsic_sdk_cmake.
  </description>

  <maintainer email="wjwwood@intrinsic.ai">William Woodall</maintainer>

  <license>Apache-2.0</license>

  <author email="wjwwood@intrinsic.ai">William Woodall</author>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_vendor_package</buildtool_depend>

  <!--
    TODO(wjwwood): tinygltf is required by the Intrinsic SDK (e.g. gltf_io.cc).
    Ubuntu provides libtinygltf-dev in apt, but there is currently no upstream
    rosdep key for libtinygltf-dev (and Ubuntu 24.04 ships 2.8.x whereas the SDK
    pins 2.9.6). Once a rosdep key exists and supported distros ship a compatible
    version (or SDK C++ targets are extracted from Bazel), this vendor package
    can be retired.
  -->

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
